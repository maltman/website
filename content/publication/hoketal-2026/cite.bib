@misc{10.21203/rs.3.rs-11134352/v1,
    author = {Hok, Hannah and Altman, Micah and Aeulua-Toomey, Sakaria, and Bourg, Chris},
    title = {Epistemological and social beliefs are associated with support for different open science practices across the social sciences,},
    publisher = {Research Squared},
    abstract = {Open science comprises a range of practices that advance different goals, yet it is often treated as an expression of a single orientation toward openness. We ran a pre-specified, stratified survey of researchers at 292 U.S. universities to examine whether researchers’ beliefs about scientific knowledge and scientific communities were associated with attitudes toward data sharing, preregistration, open access, and replication across eight social science disciplines. More positivist beliefs were associated with stronger support for data sharing, preregistration, and replication, and with weaker support for open access. Perceiving science as exclusionary was associated with stronger support for open access and data sharing. These relationships held after adjustment for disciplinary affiliation and methodological orientation. The findings indicate that open science is not supported for a single reason: different practices appeal to distinct but overlapping epistemic and social commitments.
},
    doi = {https://doi.org/10.21203/rs.3.rs-11134352/v1},
}
